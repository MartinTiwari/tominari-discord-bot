# ---- Required ----
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_id_here

# Optional: register slash commands to one guild instantly (recommended while developing).
# Leave blank to register globally (can take up to 1 hour to propagate).
DISCORD_GUILD_ID=

# ---- News ----
# https://newsapi.org  (free tier: 100 requests/day). Optional — RSS feeds work without it.
NEWSAPI_KEY=

# ---- Sports ----
# Sports data is LIVE WITHOUT ANY KEY: the bot reads TheSportsDB, which needs no
# registration. Both keys below are optional upgrades.
#
# RapidAPI key for API-Football (https://rapidapi.com/api-sports/api/api-football).
# Set it for full 18/20-team league tables — the keyless provider returns the
# top 5 only. Free tier is 100 calls/day.
SPORTS_API_KEY=
# A TheSportsDB Patreon key, if you have one. Defaults to their public test key.
SPORTSDB_KEY=

# ---- Storage ----
DB_PATH=./data/tominari.db

# ---- Channel overrides ----
# These override the "channels" block in config.json when set.
POLITICS_CHANNEL_ID=
BUSINESS_CHANNEL_ID=
SPORTS_CHANNEL_ID=
TECH_CHANNEL_ID=
ENTERTAINMENT_CHANNEL_ID=
WORLD_CHANNEL_ID=
SOCIAL_FEED_CHANNEL_ID=

# ---- RONB (Routine of Nepal Banda) ----
# RONB is the social feed's headline source:
#   Facebook  https://www.facebook.com/officialroutineofnepalbanda
#   Instagram https://www.instagram.com/routineofnepalbanda/
#
# Neither platform serves posts to a server without credentials — Facebook shows
# a login wall and Instagram rejects unauthenticated reads — so pick ONE route
# below. With none of them set the feed still runs on the newspaper sources; you
# just won't get RONB's banda alerts.
#
# Route 1 (best): Meta Graph API. Needs a page access token from Meta, which is
# only granted for accounts you own or have been given access to.
FB_PAGE_ACCESS_TOKEN=
RONB_FB_PAGE_ID=
IG_USER_ID=
#
# Route 2 (easiest): point these at any RSS feed that mirrors RONB. Create one
# with a bridge service (rss.app, fetchrss.com) or your own RSSHub instance,
# then paste the feed URL here.
RONB_FB_FEED=
RONB_IG_FEED=
#
# Route 3 (automatic, no setup): @RONBupdates on X, read through X's public
# embed timeline. Enabled by default, but that account has been dormant since
# September 2025 so it usually returns nothing. Set to "true" to switch off.
RONB_DISABLE_X=false
# Route 4 (automatic): routineofnepalbanda.com/feed — their own site, currently
# returning HTTP 522. Left on so it resumes by itself if the site comes back.
RONB_DISABLE_MIRROR=false

# ---- Optional scraping ----
# Set to "true" to enable the experimental Puppeteer fallback scraper.
ENABLE_PUPPETEER_SCRAPER=false

# ---- Logging ----
LOG_LEVEL=info
