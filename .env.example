# ---- Required ----
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_id_here

# Optional: register slash commands to one guild instantly (recommended while developing).
# Leave blank to register globally (can take up to 1 hour to propagate).
DISCORD_GUILD_ID=

# ---- News ----
# https://newsapi.org  (free tier: 100 requests/day). Optional — RSS feeds work without it.
NEWSAPI_KEY=

# ---- Sports ----
# RapidAPI key for API-Football (https://rapidapi.com/api-sports/api/api-football).
# Optional — the bot falls back to bundled fixture/standings data when absent.
SPORTS_API_KEY=

# ---- Storage ----
DB_PATH=./data/tominari.db

# ---- Channel overrides ----
# These override the "channels" block in config.json when set.
POLITICS_CHANNEL_ID=
BUSINESS_CHANNEL_ID=
SPORTS_CHANNEL_ID=
TECH_CHANNEL_ID=
ENTERTAINMENT_CHANNEL_ID=
WORLD_CHANNEL_ID=
SOCIAL_FEED_CHANNEL_ID=

# ---- Optional scraping ----
# Facebook Graph API page token (needs Meta business approval). Without it the bot
# uses each outlet's public RSS feed instead of scraping Facebook.
FB_PAGE_ACCESS_TOKEN=
# Set to "true" to enable the experimental Puppeteer fallback scraper.
ENABLE_PUPPETEER_SCRAPER=false

# ---- Logging ----
LOG_LEVEL=info
